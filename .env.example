# --- Postgres ---
POSTGRES_PASSWORD=bi_local_dev_pw
DATABASE_URL=postgresql://bi_admin:bi_local_dev_pw@localhost:5432/bi_platform

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API (apps/api) ---
JWT_SECRET=change_me_dev_only
JWT_EXPIRES_IN=8h
API_PORT=4000
ENGINE_BASE_URL=http://localhost:8000
PLATFORM_ADMIN_KEY=change_me_dev_only_platform_admin_key

# --- Engine (apps/engine) ---
ENGINE_PORT=8000
DATABASE_URL_ENGINE=postgresql://bi_admin:bi_local_dev_pw@localhost:5432/bi_platform

# --- AI provider ---
ANTHROPIC_API_KEY=
AI_CHEAP_MODEL=claude-haiku-4-5-20251001
AI_CAPABLE_MODEL=claude-sonnet-5

# --- Vault / secrets for data connection credentials ---
# Local dev: symmetric key used to encrypt connector credentials at rest in engine's own vault table.
# Production: swap for a real secrets manager (Vault, AWS Secrets Manager, GCP Secret Manager).
CREDENTIALS_ENCRYPTION_KEY=change_me_32_byte_key_for_dev_only

# --- SMTP (alert emails, scheduled report emails) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@bi-ai-platform.local

# --- Web (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
